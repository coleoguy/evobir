#   sig2 = the Brownian motion rate parameter (variance per unit time)
#   internal = FALSE means only return values for tips, not internal nodes
trait_values <- fastBM(
tree = tree,           # Our simulated ultrametric tree
a = ancestral_state,   # Starting value at the root
sig2 = bm_rate,        # Rate of trait evolution
internal = FALSE       # Only return tip values
)
# Print summary statistics of the simulated trait values
cat("\n--- Trait Value Summary ---\n")
cat("Minimum:", round(min(trait_values), 3), "\n")
cat("Maximum:", round(max(trait_values), 3), "\n")
cat("Mean:", round(mean(trait_values), 3), "\n")
cat("Standard Deviation:", round(sd(trait_values), 3), "\n")
# -----------------------------------------------------------------------------
# STEP 6: CREATE COLORBLIND-FRIENDLY COLOR MAPPING
# -----------------------------------------------------------------------------
# Define the number of discrete color bins for the gradient
# More bins = smoother color gradient
n_colors <- 100
# Generate a viridis color palette
# viridis is specifically designed to be:
#   1. Colorblind friendly (deuteranopia, protanopia, tritanopia safe)
#   2. Perceptually uniform (equal steps = equal perceptual change)
#   3. Readable in grayscale (for printing)
# Option "D" is the default viridis palette (purple -> blue -> green -> yellow)
color_palette <- viridis(n = n_colors, option = "D")
# Normalize trait values to range [0, 1] for color mapping
# Formula: (x - min) / (max - min) scales any range to [0, 1]
trait_min <- min(trait_values)  # Store minimum for scaling
trait_max <- max(trait_values)  # Store maximum for scaling
trait_normalized <- (trait_values - trait_min) / (trait_max - trait_min)
# Convert normalized values to color indices (1 to n_colors)
# We multiply by (n_colors - 1) and add 1 to get indices in range [1, n_colors]
# floor() rounds down to get integer indices
color_indices <- floor(trait_normalized * (n_colors - 1)) + 1
# Map indices to actual colors from our palette
# This creates a named vector of colors, one for each tip
tip_colors <- color_palette[color_indices]
# Assign tip labels as names to the color vector
# This ensures colors match correctly when plotting
names(tip_colors) <- names(trait_values)
# -----------------------------------------------------------------------------
# STEP 7: REORDER COLORS TO MATCH TREE TIP ORDER
# -----------------------------------------------------------------------------
# IMPORTANT: The order of tips in trait_values may not match plot order
# tree$tip.label contains tip labels in the order they appear in the tree
# We must reorder our colors to match this order for correct plotting
tip_colors_ordered <- tip_colors[tree$tip.label]
# -----------------------------------------------------------------------------
# STEP 8: CREATE THE PLOT
# -----------------------------------------------------------------------------
# Set up the plotting device with appropriate margins
# mar = c(bottom, left, top, right) margins in lines
# oma = outer margins for the color bar legend
par(mar = c(2, 2, 2, 2), oma = c(0, 0, 0, 4))
# Plot the phylogenetic tree using plot.phylo() from ape
# Arguments explained:
#   x = the tree object to plot
#   type = "phylogram" draws a standard rectangular phylogeny
#   tip.color = vector of colors for each tip label
#   cex = character expansion factor for tip labels (0.8 = 80% of default)
#   font = font style for tip labels (1 = plain, 2 = bold, 3 = italic)
#   label.offset = small gap between tree tips and labels
#   edge.width = line thickness for tree branches
#   no.margin = FALSE keeps margins we set with par()
plot.phylo(
x = tree,
type = "phylogram",
tip.color = tip_colors_ordered,
cex = 0.8,
font = 1,
label.offset = 0.02,
edge.width = 2,
no.margin = FALSE
)
# Add a title to the plot
# main = title text, cex.main = size multiplier for title
title(
main = "Ultrametric Phylogeny with Brownian Motion Trait Evolution",
cex.main = 1.0
)
# Add a subtitle with simulation parameters
# mtext() adds text to margins; line = which margin line to use
mtext(
text = paste("n =", n_tips, "tips | σ² =", bm_rate, "| seed = 42"),
side = 1,         # side 1 = bottom margin
line = 0.5,       # which line in the margin
cex = 0.7         # character size
)
# -----------------------------------------------------------------------------
# STEP 9: ADD A COLOR BAR LEGEND
# -----------------------------------------------------------------------------
# Create a color bar legend to show the trait value scale
# We need to add this manually in base R
# Define the position for the color bar in the right margin
# Get the current plot coordinates
plot_coords <- par("usr")  # returns c(x1, x2, y1, y2) of plot region
# Calculate color bar position (in the right margin area)
# We position it just outside the main plot area
bar_x_left <- plot_coords[2] + 0.05   # Slightly right of plot
bar_x_right <- plot_coords[2] + 0.12  # Width of color bar
bar_y_bottom <- plot_coords[3] + (plot_coords[4] - plot_coords[3]) * 0.2
bar_y_top <- plot_coords[3] + (plot_coords[4] - plot_coords[3]) * 0.8
# Allow drawing outside the main plot region
par(xpd = TRUE)
# Draw the color bar as a series of small rectangles
# Each rectangle represents one color in our palette
n_bar_segments <- 50  # Number of segments in the color bar
bar_colors <- viridis(n_bar_segments, option = "D")  # Get colors for bar
# Calculate the height of each segment
segment_height <- (bar_y_top - bar_y_bottom) / n_bar_segments
# Loop through and draw each color segment
for (i in 1:n_bar_segments) {
# Calculate y coordinates for this segment
y_bottom_seg <- bar_y_bottom + (i - 1) * segment_height
y_top_seg <- bar_y_bottom + i * segment_height
# Draw the rectangle for this color segment
# rect() draws a rectangle given corner coordinates
rect(
xleft = bar_x_left,
ybottom = y_bottom_seg,
xright = bar_x_right,
ytop = y_top_seg,
col = bar_colors[i],  # Fill color
border = NA           # No border around individual segments
)
}
# Add a border around the entire color bar
rect(
xleft = bar_x_left,
ybottom = bar_y_bottom,
xright = bar_x_right,
ytop = bar_y_top,
col = NA,              # No fill (transparent)
border = "black",      # Black border
lwd = 1                # Line width
)
# Add tick marks and labels to the color bar
# We'll add labels at the bottom, middle, and top
# Define label positions and values
label_positions <- c(bar_y_bottom, (bar_y_bottom + bar_y_top) / 2, bar_y_top)
label_values <- c(trait_min, (trait_min + trait_max) / 2, trait_max)
# Add tick marks and labels
for (j in 1:3) {
# Draw tick mark
segments(
x0 = bar_x_right,           # Start x
y0 = label_positions[j],    # Start y
x1 = bar_x_right + 0.02,    # End x (small tick)
y1 = label_positions[j],    # End y
lwd = 1
)
# Add text label
text(
x = bar_x_right + 0.03,     # x position for text
y = label_positions[j],     # y position for text
labels = round(label_values[j], 2),  # Rounded trait value
cex = 0.6,                  # Small text size
adj = 0                     # Left-align text
)
}
# Add a title for the color bar
text(
x = (bar_x_left + bar_x_right) / 2,  # Centered over bar
y = bar_y_top + 0.4,                  # Above the bar
labels = "Trait\nValue",              # Label with line break
cex = 0.7,
font = 2                              # Bold font
)
# Reset xpd parameter to default
par(xpd = FALSE)
# -----------------------------------------------------------------------------
# STEP 10: OPTIONAL - SAVE DATA FOR FUTURE USE
# -----------------------------------------------------------------------------
# Create a data frame combining tip labels and trait values
# This is useful for downstream analyses
results_df <- data.frame(
tip_label = names(trait_values),      # Tip names
trait_value = as.numeric(trait_values), # Trait values
color_hex = tip_colors                # Assigned colors (hex codes)
)
# Print the results data frame
cat("\n--- Results Data Frame ---\n")
print(results_df)
# -----------------------------------------------------------------------------
# STEP 11: SESSION INFO FOR REPRODUCIBILITY
# -----------------------------------------------------------------------------
# Print session information for complete reproducibility
# This documents R version and all loaded packages
cat("\n--- Session Information ---\n")
print(sessionInfo())
# =============================================================================
# END OF SCRIPT
