# =============================================================================
# Phylogeny and Continuous Trait Visualization
# Required packages: ape, phytools
# =============================================================================
# Load packages for phylogenetic analysis and visualization
library(ape)
library(phytools)
# Read the phylogenetic tree from NEXUS file
tree <- read.nexus("odonata.nex")
# Check if the file contains multiple trees (multiPhylo object)
# If so, extract just the first tree for our analysis
if (inherits(tree, "multiPhylo")) {
tree <- tree[[1]]  # Select the first tree from the list
}
# Verify tree is now correct class
print(class(tree))  # Should print "phylo"
# Set seed for reproducibility of trait simulation
set.seed(123)
# Simulate continuous trait evolution using Brownian Motion
# sig2 controls evolutionary rate; a sets ancestral state at root
trait_values <- fastBM(tree, sig2 = 1, a = 0)
# Define color gradient: blue (low) -> white (mid) -> red (high)
colors <- colorRampPalette(c("steelblue", "white", "firebrick"))(100)
# Create continuous character map object (don't plot yet)
trait_map <- contMap(tree, trait_values, plot = FALSE)
# Apply custom color palette to the map
trait_map$cols[] <- setNames(colors, names(trait_map$cols))
# =============================================================================
# Phylogeny and Continuous Trait Visualization
# Required packages: ape, phytools
# =============================================================================
# Load packages for phylogenetic analysis and visualization
library(ape)
library(phytools)
# Read the phylogenetic tree from NEXUS file
tree <- read.nexus("odonata.nex")
# Check if the file contains multiple trees (multiPhylo object)
# If so, extract just the first tree for our analysis
if (inherits(tree, "multiPhylo")) {
tree <- tree[[1]]  # Select the first tree from the list
}
# Verify tree is now correct class
print(class(tree))  # Should print "phylo"
# Set seed for reproducibility of trait simulation
set.seed(123)
# Simulate continuous trait evolution using Brownian Motion
# sig2 controls evolutionary rate; a sets ancestral state at root
trait_values <- fastBM(tree, sig2 = 1, a = 0)
# Create continuous character map object (don't plot yet)
trait_map <- contMap(tree, trait_values, plot = FALSE)
# Determine how many colors the contMap object uses
n_cols <- length(trait_map$cols)
# Define color gradient with matching length: blue (low) -> white (mid) -> red (high)
colors <- colorRampPalette(c("steelblue", "white", "firebrick"))(n_cols)
# Apply custom color palette to the map
trait_map$cols[] <- setNames(colors, names(trait_map$cols))
# Set up plot window with appropriate margins
par(mar = c(1, 1, 3, 1))
# Generate the visualization
plot(trait_map,
type = "fan",                              # Circular tree layout
fsize = c(0.4, 0.7),                       # Font size: tips, legend
lwd = 3,                                   # Branch width
outline = TRUE,                            # Outline branches for clarity
legend = 0.5 * max(nodeHeights(tree)),    # Scale legend to tree size
leg.txt = "Trait Value")                   # Legend title
# Add filled circles at tree tips colored by trait value
tiplabels(pch = 21,               # Circle symbol with fill
bg = tip_colors,        # Fill color from our palette
col = "black",          # Black outline
cex = 1.2)              # Size of circles
# =============================================================================
# Phylogeny and Continuous Trait Visualization
# Required packages: ape, phytools
# =============================================================================
# Load packages for phylogenetic analysis and visualization
library(ape)
library(phytools)
# Read the phylogenetic tree from NEXUS file
tree <- read.nexus("odonata.nex")
# Check if the file contains multiple trees (multiPhylo object)
# If so, extract just the first tree for our analysis
if (inherits(tree, "multiPhylo")) {
tree <- tree[[1]]
}
# Set seed for reproducibility of trait simulation
set.seed(123)
# Simulate continuous trait evolution using Brownian Motion
trait_values <- fastBM(tree, sig2 = 1, a = 0)
# Define color gradient: blue (low) -> white (mid) -> red (high)
color_palette <- colorRampPalette(c("steelblue", "white", "firebrick"))(100)
# Scale trait values to integers between 1 and 100 for color indexing
trait_min <- min(trait_values)
trait_max <- max(trait_values)
trait_scaled <- round((trait_values - trait_min) / (trait_max - trait_min) * 99) + 1
# Match colors to each tip based on its trait value
# Order must match the tip labels in the tree
tip_colors <- color_palette[trait_scaled[tree$tip.label]]
# Set up plot window with space for legend at bottom
par(mar = c(5, 1, 3, 1))
# Plot the phylogenetic tree
plot(tree,
type = "fan",                # Circular tree layout
show.tip.label = TRUE,       # Show species names
cex = 0.3,                   # Size of tip labels
edge.width = 2,              # Thickness of branches
edge.color = "gray30",       # Color of branches
label.offset = 0.5)          # Space between tips and labels
# Add filled circles at tree tips colored by trait value
tiplabels(pch = 21,               # Circle symbol with fill
bg = tip_colors,        # Fill color from our palette
col = "black",          # Black outline
cex = 1.2)              # Size of circles
# Add a color bar legend at the bottom of the plot
add.color.bar(leg = 40,                              # Length of legend bar
cols = color_palette,                   # Our color palette
title = "Trait Value",                  # Legend title
lims = c(round(trait_min, 1), round(trait_max, 1)),  # Range
digits = 1,                             # Decimal places
prompt = FALSE,                         # Auto-place legend
x = -35,                                # X position
y = -55,                                # Y position
fsize = 0.8,                            # Font size
lwd = 6,                                # Bar thickness
subtitle = "")                          # No subtitle
# Add title to the plot
title(main = "Odonata Phylogeny with Simulated Trait",
font.main = 2,
cex.main = 1.2)
# =============================================================================
# Phylogeny and Continuous Trait Visualization
# Required packages: ape, phytools
# =============================================================================
# Load packages for phylogenetic analysis and visualization
library(ape)
library(phytools)
# Read the phylogenetic tree from NEXUS file
tree <- read.nexus("odonata.nex")
# Check if the file contains multiple trees (multiPhylo object)
# If so, extract just the first tree for our analysis
if (inherits(tree, "multiPhylo")) {
tree <- tree[[1]]
}
# Set seed for reproducibility of trait simulation
set.seed(123)
# Simulate continuous trait evolution using Brownian Motion
trait_values <- fastBM(tree, sig2 = 1, a = 0)
# Create colors for tips
color_palette <- colorRampPalette(c("blue", "yellow", "red"))(100)
trait_scaled <- round((trait_values - min(trait_values)) /
(max(trait_values) - min(trait_values)) * 99) + 1
tip_colors <- color_palette[trait_scaled[tree$tip.label]]
# Set up plot with extra space on the right for legend
par(mar = c(2, 2, 3, 8))
# Plot tree without tip labels
plot(tree,
type = "phylogram",          # Rectangular tree layout
show.tip.label = FALSE,      # Hide species names
edge.width = 2,              # Thickness of branches
edge.color = "gray30")       # Color of branches
# Add small solid circles at tips with no outline
tiplabels(pch = 19,               # Solid circles (no outline)
col = tip_colors,       # Fill color from our palette
cex = 0.5)              # Smaller circle size
# Add title
title("Odonata Phylogeny with Simulated Trait")
# Add legend outside the plot area on the right side
legend("right",
legend = c("High", "Medium", "Low"),
pch = 19,
col = c("red", "yellow", "blue"),
title = "Trait Value",
cex = 0.9,
xpd = TRUE,                # Allow legend outside plot area
inset = c(-0.15, 0),       # Push legend to the right margin
bty = "n")                 # No box around legend
