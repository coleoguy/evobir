# Load required packages
# Install if needed: install.packages(c("ape", "phytools"))
library(ape)
library(phytools)
# 1) Read in the phylogenetic tree in Newick format
tree <- read.tree("cyprinidae.new")
# 2) Simulate a discrete trait with 5 states
# Define number of states
n_states <- 5
state_names <- c("State1", "State2", "State3", "State4", "State5")
# Create a transition rate matrix (Q matrix) for simulation
# Using equal rates model
Q <- matrix(rep(1, n_states^2), n_states, n_states)
diag(Q) <- 0
diag(Q) <- -rowSums(Q)
rownames(Q) <- colnames(Q) <- state_names
# Simulate the discrete character using sim.history
sim_result <- sim.history(tree, Q, nsim = 1)
# Extract the tip states
tip_states <- sim_result$states
# 3) Define colors for the 5 states
colors <- c("red", "blue", "green", "purple", "orange")
names(colors) <- state_names
# Assign colors to each tip based on its state
tip_colors <- colors[tip_states]
# 4) Plot the phylogeny
# Set up the plot with no tip labels (requirement 5)
plot(tree,
show.tip.label = FALSE,  # Do not print species names
type = "phylogram",
edge.width = 1.5,
main = "Cyprinidae Phylogeny with Simulated Discrete Trait")
# Add circles at the tips to indicate character states
tiplabels(pch = 21,           # Filled circles
bg = tip_colors,     # Fill color based on state
col = "black",       # Border color
cex = 1.5,           # Size of circles
adj = 0.5)           # Position adjustment
# 5) Add a legend
legend("bottomleft",
legend = state_names,
pch = 21,
pt.bg = colors,
col = "black",
pt.cex = 1.5,
title = "Character States",
bty = "n")              # No box around legend
# Load required packages
# Install if needed: install.packages(c("ape", "phytools"))
library(ape)
library(phytools)
# 1) Read in the phylogenetic tree in Newick format
tree <- read.tree("cyprinidae.new")
# 2) Simulate a discrete trait with 5 states
# Define number of states
n_states <- 5
state_names <- c("State1", "State2", "State3", "State4", "State5")
# Create a transition rate matrix (Q matrix) for simulation
# Using equal rates model
Q <- matrix(rep(1, n_states^2), n_states, n_states)
diag(Q) <- 0
diag(Q) <- -rowSums(Q)
rownames(Q) <- colnames(Q) <- state_names
# Simulate the discrete character using sim.history
sim_result <- sim.history(tree, Q, nsim = 1)
# Extract the tip states
tip_states <- sim_result$states
# 3) Define colors for the 5 states
colors <- c("red", "blue", "green", "purple", "orange")
names(colors) <- state_names
# Assign colors to each tip based on its state
tip_colors <- colors[tip_states]
# 4) Plot the phylogeny as a circular/fan tree
# Set up the plot with no tip labels (requirement 5)
plot(tree,
show.tip.label = FALSE,  # Do not print species names
type = "fan",            # Circular/fan layout for large trees
edge.width = 0.5,        # Thinner edges for large trees
main = "Cyprinidae Phylogeny with Simulated Discrete Trait")
# Add circles at the tips to indicate character states
# Reduced circle size by half (from 1.5 to 0.75)
tiplabels(pch = 21,           # Filled circles
bg = tip_colors,     # Fill color based on state
col = "black",       # Border color
cex = 0.75,          # Reduced size of circles (half of original)
adj = 0.5)           # Position adjustment
# 5) Add a legend
legend("bottomleft",
legend = state_names,
pch = 21,
pt.bg = colors,
col = "black",
pt.cex = 1.5,
title = "Character States",
bty = "n")              # No box around legend
